{
  "app": {
    "name": "telegram-bot",
    "script": "src/index.js",
    "watch": false,
    "autorestart": true,
    "env": {
      "NODE_ENV": "production"
    },
    "ignore_watch": [
      "node_modules",
      "logs",
      "uploadFiles"
    ],
    "instances": 1,
    "error_file": "./logs/err.log",
    "out_file": "./logs/out.log",
    "log_date_format": "YYY-MM-DD HH:mm:ss"
  }
}